Use o código com cuidado.2. O Script de Monitoramento (monitor.py)Este script deve rodar em background. Ele captura o handshake inicial (SYN) para identificar novas conexões e consultas DNS para saber "para onde" o usuário está indo (ex: ://openai.com).Salve este script na sua imagem ou via LCC em /home/sagemaker-user/network_monitor.py:pythonimport subprocess
import re
import datetime

LOG_FILE = "/home/sagemaker-user/audit_network.log"

# Comando para capturar DNS (porta 53) e inícios de conexão TCP (SYN)
# Filtramos para pegar o tráfego de saída
cmd = ["tcpdump", "-i", "any", "-n", "-l", "port 53 or (tcp[tcpflags] & (tcp-syn) != 0)"]

print(f"Monitoramento iniciado. Logs em: {LOG_FILE}")

with open(LOG_FILE, "a") as f:
    process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in iter(process.stdout.readline, ""):
        timestamp = datetime.datetime.now().isoformat()
        
        # Identifica se é DNS ou Conexão IP
        if "A?" in line or "AAAA?" in line:
            # Captura o domínio solicitado
            match = re.search(r"A\? ([\w\.\-]+)", line)
            if match:
                f.write(f"{timestamp} | EVENT: DNS_QUERY | DOMAIN: {match.group(1)}\n")
        elif "Flags [S]" in line:
            # Captura IP e Porta de destino
            match = re.search(r"IP ([\d\.]+) > ([\d\.]+)\.(\d+): Flags \[S\]", line)
            if match:
                f.write(f"{timestamp} | EVENT: TCP_CONN | SRC: {match.group(1)} | DST: {match.group(2)} | PORT: {match.group(3)}\n")
        
        f.flush()
