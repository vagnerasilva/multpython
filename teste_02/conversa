# Inicia o monitoramento em background
# O awk é usado para colocar a data atual em cada linha
nohup stdbuf -oL tcpdump -i any -n -l 'udp port 53 or (tcp[tcpflags] & tcp-syn != 0)' 2>/dev/null \

| while read line; do
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $line" >> "$LOG_FILE"
done &
